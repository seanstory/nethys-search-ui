# Copy this file to .env and fill in your credentials.
# .env is gitignored — never commit real credentials.

# Elastic Cloud ID (found in the Elastic Cloud console under your deployment)
ES_CLOUD_ID=your-deployment-name:base64encodedstring==

# API key with read/write access to the search-nethys index and crawler indices
# Create in Kibana: Stack Management → API Keys
ES_API_KEY=your_api_key_here

# Enterprise Search / App Search endpoint and private API key
# Found in Kibana: Search → App Search → Credentials
ENT_SEARCH_ENDPOINT=https://your-deployment.ent.us-west2.gcp.elastic-cloud.com
ENT_SEARCH_PRIVATE_KEY=private-your_private_key_here
